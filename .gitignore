# --- pilot-100 intermediates ----------------------------------------------
# Per-genome AMRFinderPlus reports are large regenerable intermediates.
# They are reused across runs, so they are ignored by git but kept on disk.
results/pilot100/amrfinder/

# --- locally built tools ----------------------------------------------------
# A compiled binary is a build artifact, never a source file. Regenerate with
# scripts/build_gubbins_from_source.sh (pinned to gubbins v3.4.3); it asserts its
# own test suite passes and verifies the zlib linkage before installing.
tools/

# --- agent artefacts: never published ----------------------------------------
# Round reports, storage surveys, run bundles and the dashboard's own design docs.
# These are working notes about this repository, not part of the pipeline: they
# name local absolute paths, quote intermediate counts, and grow without bound.
# `pa-artifacts/ui/*.md` arrived with the ui-dashboard merge (be539a6) and was
# untracked at publish time rather than deleted from disk. The dashboard's real
# documentation lives in docs/.
pa-artifacts/
pa-backups/

# --- dashboard runtime ------------------------------------------------------
# The dashboard binds to 127.0.0.1 only and writes nothing outside its state dir,
# but a local run leaves these behind.
dashboard/.state/
dashboard/**/node_modules/

# --- large regenerable bioinformatics outputs --------------------------------
# Aligned reads, called variants and protein/gene FASTAs are inputs to a stage or
# products of one. They are gigabytes, they are reproducible, and no reader needs
# them in the history. The committed synthetic fixtures under test_data/ are
# un-ignored explicitly above (`!test_data/variants/*.vcf` and friends), so this
# does not untrack the test suite.
*.bam
*.bai
*.vcf
*.vcf.gz
*.bcf
*.cram
*.sam
*.faa
bakta/
bakta_db/

# --- logs and scratch -------------------------------------------------------
logs/
*.log

# --- javascript -------------------------------------------------------------
node_modules/
.build/
