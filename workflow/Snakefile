rule phylogeny:
    """Stage 9: phylogenomics, with strict tree/manifest validation.

    spec.md D1 puts stage 8 (`recombination`) upstream of stage 9, so
    `OUT_RECOMBINATION` is a produced input.

    **`tree.nwk` and `tree_metadata.tsv` are OUTPUTS of this rule**, not
    externals. `stages/phylogeny.build_tree_outputs` writes both into
    `phylogeny_dir` with IQ-TREE, and this rule is their only producer. They used
    to be declared in the `external` list, which asked Snakemake to resolve as
    inputs the files the rule itself produces - so the REAL DAG could never be
    built from nothing, and satisfying it meant placing a tree on disk by hand.
    Every downstream rule that reads them (`similarity`, `gwas`, `convergence`,
    `cooccurrence`) now gets a real edge from here instead.

    Note what this does NOT do: it does not make the tree's *input* exist. The
    alignment stage 9 reads is `core_snp_alignment.fasta`, written into the same
    directory by stage 8 (`recombination`) in REAL and by a committed fixture in
    TEST. That file is still an external, because nothing in this workflow
    produces it in TEST.
    """
    input:
        stage_inputs([OUT_RECOMBINATION], [COHORT_INPUT]),
    output:
        OUT_PHYLO,
        TREE_IN,
        TREE_META_IN,
    threads: THREADS
    resources:
        mem_mb=MEMORY_MB
    log:
        str(LOG_DIR / "10_phylogeny.log"),
    shell:
        "python3 " + str(PIPELINE_ROOT / "scripts" / "run_rule.py")
        + " --stage phylogeny --status-log " + str(STATUS_LOG) + " -- "
        "python3 {RUN_STAGE} --mode {MODE} --machine {MACHINE} --stage phylogeny --log-file {log} 2>&1"


